# Server Configuration
PORT=5001
NODE_ENV=production

# Database Configuration (MongoDB Atlas Connection String)
# Supports both MONGODB_URI and MONGO_URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/carservice?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/carservice?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here

# Client URLs (Production Vercel Domain for CORS allowlist and password reset links)
# Example: https://car-service-mechanic-hub.vercel.app
FRONTEND_URL=https://your-frontend-name.vercel.app
CLIENT_URL=https://your-frontend-name.vercel.app

# Optional: Comma-separated list of additional allowed origins for CORS
# ALLOWED_ORIGINS=https://your-frontend-name.vercel.app,https://your-custom-domain.com

# Email Configuration (Gmail SMTP / Nodemailer)
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_digit_gmail_app_password
EMAIL_PASSWORD=your_16_digit_gmail_app_password
EMAIL_FROM="MRT Car Service" <your_email@gmail.com>

